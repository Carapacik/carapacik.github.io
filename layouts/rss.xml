{{- $pages := where site.RegularPages "Section" "posts" -}}
{{- if not .IsHome -}}{{- $pages = where .RegularPagesRecursive "Section" "posts" -}}{{- end -}}
{{- $pages = where $pages "Params.hiddenInRss" "!=" true -}}
{{- $pages = $pages.ByDate.Reverse -}}
{{- $limit := site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 -}}{{- $pages = $pages | first $limit -}}{{- end -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ .Title }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ i18n "rss_description" }}</description>
    <language>{{ .Language.Locale }}</language>
    {{ with .OutputFormats.Get "RSS" }}<atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml"/>{{ end }}
    {{ range $pages }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <guid>{{ .Permalink }}</guid>
      {{ with .PublishDate }}<pubDate>{{ .Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>{{ end }}
      <description>{{ partial "page-description.html" . }}</description>
    </item>
    {{ end }}
  </channel>
</rss>
